            <input class=" mt-2 w-1/4 rounded-md outline-none block px-5 nt-2 py-2 bg-zinc-800 resize-none"
                name="new" type="text" id="" placeholder="New name">
            <input class=" bg-yellow-600 px-5 py-2 mt-2" type="submit" value="Update task">
        </form>
    </div>


</body>

